{
  "name": "@hotflow/runtime-bootstrap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@hotflow/config": "workspace:*",
    "@hotflow/context": "workspace:*",
    "@hotflow/director-knowledge": "workspace:*",
    "@hotflow/director-runtime": "workspace:*",
    "@hotflow/engine": "workspace:*",
    "@hotflow/internal-plugin-provider-scripted": "workspace:*",
    "@hotflow/internal-plugin-tool-filesystem-read": "workspace:*",
    "@hotflow/memory-core": "workspace:*",
    "@hotflow/mempalace-adapter": "workspace:*",
    "@hotflow/models": "workspace:*",
    "@hotflow/observability": "workspace:*",
    "@hotflow/plugin-runtime": "workspace:*",
    "@hotflow/sessions": "workspace:*",
    "@hotflow/skills": "workspace:*",
    "@hotflow/tasks-core": "workspace:*",
    "@hotflow/tools": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  }
}
