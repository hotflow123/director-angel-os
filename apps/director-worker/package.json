{
  "name": "@hotflow/director-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsx --tsconfig ./tsconfig.dev.json src/main.ts",
    "lint": "biome check src tests",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --build tsconfig.json --pretty false"
  },
  "dependencies": {
    "@hotflow/director-execution": "workspace:*",
    "@hotflow/director-execution-contracts": "workspace:*",
    "@hotflow/director-memory": "workspace:*",
    "@hotflow/director-memory-contracts": "workspace:*",
    "@hotflow/director-proposals": "workspace:*",
    "@hotflow/director-runtime": "workspace:*",
    "@hotflow/director-workspace": "workspace:*",
    "@hotflow/sessions": "workspace:*",
    "@hotflow/tasks-core": "workspace:*"
  }
}
