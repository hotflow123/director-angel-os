    "@hotflow/channels-core": "workspace:*",
    "@hotflow/config": "workspace:*",
    "@hotflow/context": "workspace:*",
    "@hotflow/contracts": "workspace:*",
    "@hotflow/control-plane": "workspace:*",
    "@hotflow/doctor": "workspace:*",
    "@hotflow/director-execution": "workspace:*",
    "@hotflow/director-execution-contracts": "workspace:*",
    "@hotflow/director-host-contracts": "workspace:*",
    "@hotflow/director-knowledge": "workspace:*",
    "@hotflow/director-memory": "workspace:*",
    "@hotflow/director-memory-contracts": "workspace:*",
    "@hotflow/director-proposals": "workspace:*",
    "@hotflow/director-runtime": "workspace:*",
    "@hotflow/director-workspace": "workspace:*",
    "@hotflow/engine": "workspace:*",
    "@hotflow/memory-core": "workspace:*",
    "@hotflow/models": "workspace:*",
    "@hotflow/observability": "workspace:*",
    "@hotflow/plugin-runtime": "workspace:*",
    "@hotflow/runtime-bootstrap": "workspace:*",
    "@hotflow/policy-runtime": "workspace:*",
    "@hotflow/sessions": "workspace:*",
    "@hotflow/skills": "workspace:*",
    "@hotflow/tasks-core": "workspace:*",
    "@hotflow/tools": "workspace:*"
  }
