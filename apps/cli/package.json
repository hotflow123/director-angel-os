{
  "name": "@hotflow/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "bin": {
    "hotflow": "./dist/main.js",
    "director-angel": "./dist/director-angel-main.js"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsx --tsconfig ./tsconfig.dev.json src/main.ts",
    "lint": "biome check src",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --build tsconfig.json --pretty false"
  },
  "dependencies": {
    "@hotflow/agent-os-kernel-contracts": "workspace:*",
