    "bench:director-agent-os-non-voice-provider-smoke-candidate": "pnpm --dir benchmarks bench:director-agent-os-non-voice-provider-smoke-candidate",
    "bench:director-agent-os-release-smoke-admission": "pnpm --dir benchmarks bench:director-agent-os-release-smoke-admission",
