    "bench:director-agent-os-release-smoke-evidence-manifest-schema-validator-readiness": "pnpm --dir benchmarks bench:director-agent-os-release-smoke-evidence-manifest-schema-validator-readiness",
    "bench:director-agent-os-release-smoke-evidence-manifest-validation": "pnpm --dir benchmarks bench:director-agent-os-release-smoke-evidence-manifest-validation",
    "bench:director-agent-os-release-smoke-execution-preflight": "pnpm --dir benchmarks bench:director-agent-os-release-smoke-execution-preflight",
