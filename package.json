{
  "name": "director-angel-os",
  "private": true,
  "version": "0.1.0",
  "description": "Director Angel OS is a role-driven Agent OS for turning defined positions into governed, session-aware AI operators with bounded tools, memory, evidence, review, and evolution.",
  "license": "MIT",
  "keywords": [
    "agent-os",
    "typescript",
    "session-aware-agents",
    "tool-using-agents",
    "policy-governed-agents",
    "operator-controlled-learning"
  ],
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "bench:all": "pnpm --dir benchmarks bench:all",
    "bench:director-agent-os-all": "pnpm --dir benchmarks bench:director-agent-os-all",
