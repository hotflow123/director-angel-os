    "bench:director-agent-os-desktop-smoke-manual-run-artifact-validator": "pnpm --dir benchmarks bench:director-agent-os-desktop-smoke-manual-run-artifact-validator",
    "bench:director-agent-os-memory-eval-ops": "pnpm --dir benchmarks bench:director-agent-os-memory-eval-ops",
    "bench:director-agent-os-memory-dataset-loader-anonymization": "pnpm --dir benchmarks bench:director-agent-os-memory-dataset-loader-anonymization",
    "bench:director-agent-os-memory-eval-dashboard-maintenance": "pnpm --dir benchmarks bench:director-agent-os-memory-eval-dashboard-maintenance",
    "bench:director-agent-os-memory-sweep-safety": "pnpm --dir benchmarks bench:director-agent-os-memory-sweep-safety",
