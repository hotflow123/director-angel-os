{
  "name": "@hotflow/conversation-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "biome check src tests",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@hotflow/agent-os-extensions": "workspace:*",
    "@hotflow/agent-os-kernel-contracts": "workspace:*",
    "@hotflow/agent-os-sandbox": "workspace:*",
    "@hotflow/director-core": "workspace:*",
    "@hotflow/policy-runtime": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "croner": "10.0.1"
  }
}
