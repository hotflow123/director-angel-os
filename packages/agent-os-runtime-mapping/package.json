{
  "name": "@hotflow/agent-os-runtime-mapping",
  "version": "0.1.0",
  "private": true,
  "description": "Agent OS Phase A.1 mapping helpers from existing channel/runtime/session evidence into kernel envelopes and timelines.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "biome check src tests",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hotflow/agent-os-kernel-contracts": "workspace:*",
    "@hotflow/channels-core": "workspace:*",
    "@hotflow/contracts": "workspace:*",
    "@hotflow/conversation-runtime": "workspace:*",
    "@hotflow/sessions": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
