{
  "name": "@hotflow/director-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "biome check src tests",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --build tsconfig.json --pretty false"
  },
  "dependencies": {
    "@hotflow/conversation-runtime": "workspace:*",
    "@hotflow/director-core": "workspace:*",
    "@hotflow/director-host-contracts": "workspace:*",
    "@hotflow/live-runner-core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
